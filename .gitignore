# ==============================================================================
# Git Ignore - PROYECTOS R&F, C.A.
# Exclusiones para desarrollo local, archivos temporales y despliegue en la nube
# ==============================================================================

# Entorno y Secretos
.env
.env.*
!.env.example

# Entorno virtual de Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Caché y compilados de Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Base de datos local
instance/
*.db
*.sqlite
*.sqlite3

# Archivos pesados de origen, presentaciones y temporales de Office
*.ppt
*.pptx
*.zip
*.rar
*.7z
~$*
Presentación PROYECTOS R&F VZLA/
Presentacio*n PROYECTOS R&F VZLA*
Presentación*/
Presentacio*n*/

# Archivos temporales de trabajo y scratch
scratch*
scratch/
*.tmp
*.bak
*.swp
*.swo

# Configuración de agentes y herramientas locales
.agents/
.playwright-mcp/

# Logs del servidor y procesos
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configuraciones de editores / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Archivos generados por el Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Node / Vite
node_modules/
.vite/
